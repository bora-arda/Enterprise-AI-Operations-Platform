# Database
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/procurement
VECTOR_DB_URL=postgresql+asyncpg://user:pass@localhost:5432/procurement

# LLM Provider (optional; core workflows are deterministic and run without it)
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# Alternative: Ollama (local)
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# Embeddings (local model by default; no API key required)
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Alternative: OpenAI embeddings (requires OPENAI_API_KEY)
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=text-embedding-3-small

# Retrieval
RETRIEVAL_TOP_K=20
RERANKING_ENABLED=false
RERANKING_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Orchestration
# agent_first = agent handles all read-only questions; hybrid = deterministic fast paths + agent fallback
# Controlled actions always use the human-in-the-loop workflow.
ORCHESTRATION_MODE=agent_first

# LLM planner (hybrid mode; optional; required for the open-ended agent)
# deterministic = keyword router; llm = Claude Haiku via OpenCode Go
PLANNER_MODE=deterministic
OPENCODE_GO_API_KEY=
OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_GO_MODEL=claude-haiku-5-5
OPENCODE_SESSION_ID=procurement-ai-planner
LLM_TIMEOUT_SECONDS=20

# Agent SQL tool (read-only)
SQL_MAX_ROWS=100
SQL_QUERY_TIMEOUT_MS=5000

# Agent hardening and observability
ANSWER_VERIFICATION_ENABLED=true
TOOL_OUTPUT_MAX_CHARS=12000
TOOL_OUTPUT_INJECTION_SCAN=true
ROW_LEVEL_ACCESS_ENABLED=true
ROW_LEVEL_GLOBAL_ROLES=manager,finance,director,admin
AGENT_FAST_MODEL=
AGENT_CACHE_TTL_SECONDS=300
AGENT_PARALLEL_TOOLS=true
LLM_INPUT_COST_PER_MILLION=0.10
LLM_OUTPUT_COST_PER_MILLION=0.50
LLM_CACHE_READ_COST_PER_MILLION=0.01
LLM_INPUT_COST_PER_MILLION_HIGH=0.50
LLM_OUTPUT_COST_PER_MILLION_HIGH=2.50
LLM_COST_CONTEXT_TIER=100000

# LangSmith (optional tracing)
LANGSMITH_API_KEY=lsv2-your-key-here
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=procurement-ai

# API
API_HOST=0.0.0.0
API_PORT=8000
API_SECRET_KEY=change-me-in-production-use-32-chars-min
ACCESS_TOKEN_EXPIRE_MINUTES=480

# MCP Server
MCP_SERVER_URL=http://localhost:8001

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=admin
